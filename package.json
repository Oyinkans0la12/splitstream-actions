{
  "name": "splitstream-actions",
  "version": "0.1.0",
  "description": "GitHub Action that turns closed issues/PRs into a signed on-chain distribution manifest for splitstream-core. Computes and relays only — never holds funds.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "ncc build src/index.ts -o dist --license licenses.txt",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "github-actions",
    "stellar",
    "soroban",
    "merkle",
    "splitstream"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@stellar/stellar-sdk": "^17.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@vercel/ncc": "^0.45.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
